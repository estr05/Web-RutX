APP_NAME="RutX Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Frontera de integración (API Sincronizador v2)
# Sustituir por las URLs reales del sincronizador en cada entorno.
# Nunca versionar host o IP interno real ni CLIENT_SECRET.
API_WEB_BASE_URL=https://sincronizador.example.test/api/v2/web
API_WEB_TIMEOUT=30
API_WEB_CONNECT_TIMEOUT=10
API_WEB_AUTH_URL=https://sincronizador.example.test/api/v2/web/auth
API_WEB_CLIENT_ID=rutx-web-client
API_WEB_CLIENT_SECRET=
API_WEB_VERIFY_TLS=true

VITE_APP_NAME="${APP_NAME}"
